{
  "name": "ibc-v2-ts-relayer",
  "version": "0.0.1",
  "description": "A relayer in TS for IBC v2",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:gno:e2e": "vitest run --config vitest.config.gno.ts",
    "test:txs:e2e": "vitest run --config vitest.config.txs.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "bin": {
    "ibc-v2-relayer": "./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@atomone/atomone-types": "^4.0.2",
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/math": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@cosmjs/tendermint-rpc": "^0.39.0",
    "@cosmjs/utils": "^0.39.0",
    "@gnolang/gno-js-client": "^3.1.0",
    "@gnolang/gno-types": "^1.1.1",
    "@gnolang/tm2-js-client": "^3.3.0",
    "@gnolang/tm2-rpc": "^2.0.2",
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dexie": "^4.4.6",
    "fake-indexeddb": "^6.2.5",
    "graphql-request": "^7.4.0",
    "handlebars": "^4.7.9",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "wait-on": "^9.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@keplr-wallet/types": "^0.13.41",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts"
}
