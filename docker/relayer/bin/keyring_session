#!/usr/bin/env bash

set -e

#https://medium.com/@Aenon/bash-location-of-current-script-76db7fd2e388
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

sudo setcap cap_ipc_lock=+ep `which gnome-keyring-daemon`
# The first session caches its bus address so that later `docker exec ...
# with_keyring` sessions join it. The cache outlives the bus when the
# container restarts, so join the cached bus only while it still answers.
# `timeout` bounds the whole probe: a bus that accepts the connection and
# never answers stalls dbus-send in the handshake, which --reply-timeout
# does not cover.
CACHED_BUS_ADDRESS=$(cat /etc/DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true)
if [ -n "$CACHED_BUS_ADDRESS" ] && timeout 2 dbus-send --bus="$CACHED_BUS_ADDRESS" --print-reply \
     --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId >/dev/null 2>&1; then
  DBUS_SESSION_BUS_ADDRESS=$CACHED_BUS_ADDRESS
  export DBUS_SESSION_BUS_ADDRESS
else
  echo "$DBUS_SESSION_BUS_ADDRESS" > /etc/DBUS_SESSION_BUS_ADDRESS
fi

# killall -q -9 "$(whoami)" gnome-keyring-daemon || echo ''

#based on https://unix.stackexchange.com/a/602935
eval $(echo -n "$" \
           | gnome-keyring-daemon -r --unlock >/dev/null 2>&1 \
           | sed -e 's/^/export /')

echo '' >&2

"$@"